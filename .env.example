# =============================================================================
# KørMed — miljøvariabler / environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See README.md "Opsætning" for a full non-technical walkthrough of every value.
# =============================================================================

# --- Branding (renaming the service = change these, nothing else) ---------
NEXT_PUBLIC_APP_NAME="KørMed"
NEXT_PUBLIC_APP_TAGLINE="Skal du samme vej? KørMed."
NEXT_PUBLIC_SOCIAL_HANDLE="@KørMed"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="kontakt@example.dk"

# --- Supabase ---------------------------------------------------------------
# Found in Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Grants
# full DB access bypassing RLS — only used in trusted server actions/admin jobs.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Map / geocoding / routing provider abstraction (lib/geo) --------------
# "osm" (default, free, no key needed) or "mapbox" (requires token below).
NEXT_PUBLIC_MAP_PROVIDER="osm"
# OSM stack — safe defaults point at public demo services. These are RATE
# LIMITED and NOT suitable for production traffic. Self-host Nominatim/OSRM
# (or use a hosted provider such as Geoapify/MapTiler/Mapbox) before launch —
# see README "Kort- og geokodningsudbyder".
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OSRM_BASE_URL="https://router.project-osrm.org"
NEXT_PUBLIC_OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# Mapbox (only used if NEXT_PUBLIC_MAP_PROVIDER=mapbox)
MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Transactional email (lib/email) ----------------------------------------
# "console" (default, logs to server console — fine for local dev only),
# "resend", or "smtp".
EMAIL_PROVIDER="console"
EMAIL_FROM="KørMed <ingen-svar@example.dk>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# --- Voluntary support / donations (lib/support) -----------------------------
# Completely separate from ride payments (which the platform never touches).
# Which provider is active is chosen in the admin panel (/admin/stoette,
# app_setting "support_payment_provider") — this URL only takes effect when
# that setting is "mobilepay_link". Create a payment/box link in the
# MobilePay Business portal (no API keys needed) and paste it here.
SUPPORT_MOBILEPAY_LINK_URL=""

# --- Phone (OTP) verification ------------------------------------------------
# Handled entirely by Supabase Auth's built-in phone provider (Twilio /
# MessageBird / Vonage) — configured in the Supabase dashboard, not here.
# See README "Telefon-OTP".

# --- Background jobs ----------------------------------------------------------
# Shared secret required in the Authorization header when calling
# /api/jobs/* (ride auto-completion, retention cleanup) from a scheduler
# such as Supabase cron / Vercel Cron / GitHub Actions. See README "Drift".
CRON_SECRET="change-me"

# --- Admin bootstrap ---------------------------------------------------------
# Not read by the application code — this is just a reminder of which email
# to use. First administrator: create a normal account with this email, then
# run the SQL in README "Opret den første administrator" to grant the admin
# role. There is no automatic admin bootstrap by design (spec §22).
ADMIN_BOOTSTRAP_EMAIL=""

# --- Demo/seed data -----------------------------------------------------------
# Not read by the application code either — supabase/seed/demo.sql is a
# separate SQL script you run manually against a DEV database only (see
# README "Demo-data"). This flag is just a paper trail reminding whoever
# deploys to production that demo data must never be seeded there.
NEXT_PUBLIC_ENABLE_DEMO_SEED="false"
